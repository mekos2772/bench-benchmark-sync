{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark sync Mini Program static export",
  "type": "object",
  "required": [
    "schemaVersion", "dataSource", "exporterVersion", "generatedAt", "families", "rankings"
  ],
  "properties": {
    "schemaVersion": {"const": 3},
    "dataSource": {"const": "benchmark-sync-static"},
    "exporterVersion": {"type": "string", "minLength": 1},
    "workflowRunId": {"type": ["string", "null"]},
    "mainCommit": {"type": ["string", "null"]},
    "generatedAt": {"type": "string", "minLength": 1},
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/family"}
    },
    "rankings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/board"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "family": {
      "type": "object",
      "required": ["familyId", "title", "overall", "boards"],
      "properties": {
        "familyId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "overall": {"type": "string", "minLength": 1},
        "boards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "isOverall"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "isOverall": {"type": "boolean"},
              "modelCount": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "board": {
      "type": "object",
      "required": [
        "rankingId", "benchmarkId", "familyId", "title", "category", "release",
        "releaseId", "metric", "unit", "comparisonKey", "snapshotId", "contentHash",
        "generatedAt", "taskCount", "source", "entries"
      ],
      "properties": {
        "rankingId": {"type": "string", "minLength": 1},
        "benchmarkId": {"type": "string", "minLength": 1},
        "familyId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "releaseId": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "unit": {"enum": ["score", "ratio", "raw"]},
        "comparisonKey": {"type": "string", "minLength": 1},
        "snapshotId": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "contentHash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "generatedAt": {"type": "string", "minLength": 1},
        "taskCount": {"type": ["integer", "null"], "minimum": 1},
        "source": {
          "type": "object",
          "required": ["name", "type"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "type": {"type": "string", "minLength": 1},
            "url": {"type": ["string", "null"]},
            "evidenceUrl": {"type": ["string", "null"]},
            "tableUrl": {"type": ["string", "null"]},
            "categoriesUrl": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "minLength": 1},
              {"type": "string", "minLength": 1},
              {"type": ["number", "null"]},
              {"type": ["integer", "null"], "minimum": 1},
              {"type": ["string", "null"]}
            ],
            "minItems": 5,
            "maxItems": 5
          }
        }
      },
      "additionalProperties": true
    }
  }
}
